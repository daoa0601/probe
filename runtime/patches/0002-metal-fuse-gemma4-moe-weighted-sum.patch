+static bool ggml_metal_op_can_fuse_moe_weighted_sum(ggml_metal_op_t ctx, int idx) {
+    static constexpr ggml_op ops[9] = {
+        GGML_OP_MUL,
+        GGML_OP_MUL,
+        GGML_OP_ADD,
+        GGML_OP_ADD,
+        GGML_OP_ADD,
+        GGML_OP_ADD,
+        GGML_OP_ADD,
+        GGML_OP_ADD,
+        GGML_OP_ADD,
+    };
+
+    if (getenv("GGML_METAL_MOE_WEIGHTED_SUM_DISABLE") != nullptr ||
+        idx + 9 > ctx->n_nodes()) {
+        return false;
+    }
+
+    for (int i = 0; i < 9; ++i) {
+        const ggml_tensor * node = ctx->node(idx + i);
+        if (node->op != ops[i] ||
+            (node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            (i < 8 && (node->flags & GGML_TENSOR_FLAG_OUTPUT) != 0)) {
+            return false;
+        }
+    }
+
+    ggml_tensor * mul_scale = ctx->node(idx + 0);
+    ggml_tensor * mul_route = ctx->node(idx + 1);
+    ggml_tensor * result    = ctx->node(idx + 8);
+
+    if (mul_scale->src[0]->type != GGML_TYPE_F32 ||
+        mul_scale->src[1]->type != GGML_TYPE_F32 ||
+        mul_route->src[1]->type != GGML_TYPE_F32 ||
+        result->type            != GGML_TYPE_F32) {
+        return false;
+    }
+    if (mul_route->src[0] != mul_scale ||
+        ctx->use_count(mul_scale) != 1 ||
+        ctx->use_count(mul_route) != mul_route->ne[1] ||
+        !ggml_are_same_shape(mul_scale, mul_route) ||
+        mul_scale->ne[1] != 8 ||
+        mul_scale->ne[2] != 1 ||
+        mul_scale->ne[3] != 1 ||
+        mul_scale->src[1]->ne[0] != 1 ||
+        mul_scale->src[1]->ne[1] != mul_scale->ne[1] ||
+        mul_route->src[1]->ne[0] != 1 ||
+        mul_route->src[1]->ne[1] != mul_scale->ne[1] ||
+        result->ne[0] != mul_scale->ne[0] ||
+        result->ne[1] != 1 ||
+        result->ne[2] != 1 ||
+        result->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_is_contiguous(mul_scale->src[0]) ||
+        !ggml_is_contiguous(mul_scale->src[1]) ||
+        !ggml_is_contiguous(mul_route->src[1]) ||
+        !ggml_is_contiguous(result)) {
+        return false;
+    }
+
+    // The eight expert rows are represented by view nodes that are filtered out
+    // of ggml_metal_op::idxs. Validate the complete view/add closure explicitly:
+    // every row is consumed exactly once and every intermediate add has one use.
+    bool seen_rows[8] = {};
+    const ggml_tensor * previous_add = nullptr;
+    for (int add_idx = 0; add_idx < 7; ++add_idx) {
+        const ggml_tensor * add = ctx->node(idx + 2 + add_idx);
+        const ggml_tensor * row_views[2] = {};
+        int n_row_views = 0;
+
+        for (int src_idx = 0; src_idx < 2; ++src_idx) {
+            const ggml_tensor * src = add->src[src_idx];
+            if (previous_add != nullptr && src == previous_add) {
+                continue;
+            }
+            if (n_row_views >= 2) {
+                return false;
+            }
+            row_views[n_row_views++] = src;
+        }
+
+        const int expected_views = previous_add == nullptr ? 2 : 1;
+        if (n_row_views != expected_views ||
+            (previous_add != nullptr &&
+             add->src[0] != previous_add &&
+             add->src[1] != previous_add)) {
+            return false;
+        }
+
+        for (int view_idx = 0; view_idx < n_row_views; ++view_idx) {
+            const ggml_tensor * view = row_views[view_idx];
+            if (view == nullptr ||
+                view->op != GGML_OP_VIEW ||
+                view->view_src != mul_route ||
+                view->view_offs % mul_route->nb[1] != 0 ||
+                view->ne[0] != mul_route->ne[0] ||
+                view->ne[1] != 1 ||
+                view->ne[2] != 1 ||
+                view->ne[3] != 1 ||
+                ctx->use_count(view) != 1) {
+                return false;
+            }
+
+            const size_t row = view->view_offs / mul_route->nb[1];
+            if (row >= 8 || seen_rows[row]) {
+                return false;
+            }
+            seen_rows[row] = true;
+        }
+
+        if (add_idx < 6 && ctx->use_count(add) != 1) {
+            return false;
+        }
+        previous_add = add;
+    }
+
+    for (bool seen : seen_rows) {
+        if (!seen) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+static int ggml_metal_op_moe_weighted_sum_fused(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * mul_scale = ctx->node(idx + 0);
+    ggml_tensor * mul_route = ctx->node(idx + 1);
+    ggml_tensor * result    = ctx->node(idx + 8);
+
+    ggml_metal_kargs_moe_weighted_sum args = {
+        /*.ne0  =*/ (int32_t) mul_scale->ne[0],
+        /*.ne1  =*/ (int32_t) mul_scale->ne[1],
+        /*.nb01 =*/ mul_scale->src[0]->nb[1],
+        /*.nb11 =*/ mul_scale->src[1]->nb[1],
+        /*.nb21 =*/ mul_route->src[1]->nb[1],
+    };
+
+    const char * kernel = "kernel_moe_weighted_sum_f32";
+    auto pipeline = ggml_metal_library_get_pipeline(ctx->lib, kernel);
+    if (!pipeline.pipeline) {
+        pipeline = ggml_metal_library_compile_pipeline(ctx->lib, kernel, kernel, nullptr);
+    }
+
+    for (int i = 1; i < 9; ++i) {
+        if (!ggml_metal_op_concurrency_check(ctx, ctx->node(idx + i))) {
+            ggml_metal_op_concurrency_reset(ctx);
+            break;
+        }
+    }
+
+    ggml_metal_encoder_set_pipeline(ctx->enc, pipeline);
+    ggml_metal_encoder_set_bytes   (ctx->enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(mul_scale->src[0]), 1);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(mul_scale->src[1]), 2);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(mul_route->src[1]), 3);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(result),            4);
+
+    const int nth = 128;
+    const int ne0_vec = (args.ne0 + 3)/4;
+    ggml_metal_encoder_dispatch_threadgroups(
+        ctx->enc, (ne0_vec + nth - 1)/nth, 1, 1, nth, 1, 1);
+
+    return 9;
+}
+
 int ggml_metal_op_bin(ggml_metal_op_t ctx, int idx) {
     if (ctx->use_fusion && ggml_metal_op_can_fuse_snake(ctx, idx)) {
         return ggml_metal_op_snake_fused(ctx, idx);
     }
+    if (ctx->use_fusion && ggml_metal_op_can_fuse_moe_weighted_sum(ctx, idx)) {
+        return ggml_metal_op_moe_weighted_sum_fused(ctx, idx);
+    }

     ggml_tensor * op = ctx->node(idx);

