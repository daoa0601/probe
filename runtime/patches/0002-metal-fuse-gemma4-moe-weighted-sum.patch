+kernel void kernel_moe_weighted_sum_f32(
+        constant ggml_metal_kargs_moe_weighted_sum & args,
+        device const char * src0,
+        device const char * expert_scale,
+        device const char * routing_weight,
+        device       char * dst,
+        uint i0[[thread_position_in_grid]]) {
+    const uint ne0 = (uint) args.ne0;
+    const uint element = 4*i0;
+    if (element >= ne0) {
+        return;
+    }
+
+    if (element + 4 <= ne0) {
+        float4 sum = 0.0f;
+        for (int expert = 0; expert < args.ne1; ++expert) {
+            const float scale =
+                *((device const float *) (expert_scale + expert*args.nb11));
+            const float weight =
+                *((device const float *) (routing_weight + expert*args.nb21));
+            const device float4 * values =
+                (device const float4 *) (src0 + expert*args.nb01);
+            sum += (values[i0] * scale) * weight;
+        }
+        ((device float4 *) dst)[i0] = sum;
+        return;
+    }
+
+    for (uint tail = element; tail < ne0; ++tail) {
+        float sum = 0.0f;
+        for (int expert = 0; expert < args.ne1; ++expert) {
+            const float scale =
+                *((device const float *) (expert_scale + expert*args.nb11));
+            const float weight =
+                *((device const float *) (routing_weight + expert*args.nb21));
+            const device float * values =
+                (device const float *) (src0 + expert*args.nb01);
+            sum += (values[tail] * scale) * weight;
+        }
+        ((device float *) dst)[tail] = sum;
+    }
+}
