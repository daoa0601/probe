+static int ggml_metal_op_base_use_count(
+        ggml_metal_op_t ctx,
+        const ggml_tensor * producer) {
+    int uses = 0;
+    for (int index = 0; index < ctx->n_nodes(); ++index) {
+        const ggml_tensor * node = ctx->node(index);
+        for (int source = 0; source < GGML_MAX_SRC; ++source) {
+            if (node->src[source] != nullptr &&
+                ggml_metal_op_base_tensor(node->src[source]) == producer) {
+                ++uses;
+            }
+        }
+    }
+    return uses;
+}
