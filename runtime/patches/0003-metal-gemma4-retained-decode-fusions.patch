+static int ggml_metal_op_find_rms_norm_mul_rope(
+        ggml_metal_op_t ctx,
+        int norm_idx,
+        int n_fuse) {
+    if (n_fuse != 2) {
+        return -1;
+    }
+
+    const int search_end = std::min(ctx->n_nodes(), norm_idx + 9);
+    for (int candidate = norm_idx + n_fuse;
+         candidate < search_end;
+         ++candidate) {
+        ggml_tensor * norm = nullptr;
+        ggml_tensor * mul = nullptr;
+        ggml_tensor * weight = nullptr;
+        if (ggml_metal_op_can_fuse_rms_norm_mul_rope(
+                ctx,
+                candidate,
+                &norm,
+                &mul,
+                &weight) &&
+            norm == ctx->node(norm_idx) &&
+            mul == ctx->node(norm_idx + 1)) {
+            return candidate;
+        }
+    }
+
+    return -1;
+}
