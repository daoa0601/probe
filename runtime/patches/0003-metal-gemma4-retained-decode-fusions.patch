+static bool ggml_metal_op_can_fuse_rms_norm_mul_rope(
+        ggml_metal_op_t ctx,
+        int rope_idx,
+        ggml_tensor ** norm_out,
+        ggml_tensor ** mul_out,
+        ggml_tensor ** weight_out) {
+    if (getenv("GGML_METAL_RMS_ROPE_DISABLE") != nullptr ||
+        rope_idx < 2 ||
+        rope_idx >= ctx->n_nodes()) {
+        return false;
+    }
+
+    ggml_tensor * rope = ctx->node(rope_idx);
+    if (rope->op != GGML_OP_ROPE ||
+        rope->type != GGML_TYPE_F32 ||
+        rope->src[0] == nullptr ||
+        rope->src[1] == nullptr) {
+        return false;
+    }
+
+    ggml_tensor * mul = rope->src[0];
+    if (mul->op != GGML_OP_MUL ||
+        mul->type != GGML_TYPE_F32 ||
+        mul->src[0] == nullptr ||
+        mul->src[1] == nullptr) {
+        return false;
+    }
+
+    ggml_tensor * norm = nullptr;
+    ggml_tensor * weight = nullptr;
+    if (mul->src[0]->op == GGML_OP_RMS_NORM) {
+        norm = mul->src[0];
+        weight = mul->src[1];
+    } else {
+        return false;
+    }
+
+    int norm_idx = -1;
+    int mul_idx = -1;
+    const int search_begin = std::max(0, rope_idx - 8);
+    for (int candidate = search_begin; candidate < rope_idx; ++candidate) {
+        if (ctx->node(candidate) == norm) {
+            norm_idx = candidate;
+        }
+        if (ctx->node(candidate) == mul) {
+            mul_idx = candidate;
+        }
+    }
+    if (norm_idx < 0 || mul_idx != norm_idx + 1) {
+        return false;
+    }
+
+    const int mode = ((const int32_t *) rope->op_params)[2];
+    const int n_dims = ((const int32_t *) rope->op_params)[1];
+    if (mode != GGML_ROPE_TYPE_NEOX ||
+        (n_dims != 256 && n_dims != 512) ||
+        norm->src[0] == nullptr ||
+        norm->src[0]->type != GGML_TYPE_F32 ||
+        norm->type != GGML_TYPE_F32 ||
+        weight->type != GGML_TYPE_F32 ||
+        norm->ne[0] != n_dims ||
+        weight->ne[0] != n_dims ||
+        weight->ne[1] != 1 ||
+        weight->ne[2] != 1 ||
+        weight->ne[3] != 1 ||
+        !ggml_are_same_shape(norm, mul) ||
+        !ggml_are_same_shape(mul, rope) ||
+        ctx->use_count(norm) != 1 ||
+        ctx->use_count(mul) != 1 ||
+        !ggml_is_contiguous(norm->src[0]) ||
+        !ggml_is_contiguous(norm) ||
+        !ggml_is_contiguous(weight) ||
+        !ggml_is_contiguous(mul) ||
+        !ggml_is_contiguous(rope)) {
+        return false;
+    }
+
+    *norm_out = norm;
+    *mul_out = mul;
+    *weight_out = weight;
+
+    return true;
+}
