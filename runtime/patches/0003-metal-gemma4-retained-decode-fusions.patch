+template<short NR0>
+void kernel_mul_mv_q4_0_f32_geglu_impl(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * gate_weight,
+        device const char * up_weight,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 16;
+
+    const int nb = args.ne00/QK4_0;
+    const int r0 = (tgpig.x*NSG + sgitg)*NR0;
+    const int r1 = tgpig.y;
+    const int im = tgpig.z;
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+    const uint64_t offset1 = r1*args.nb11 + i12*args.nb12 + i13*args.nb13;
+    device const float * y = (device const float *) (src1 + offset1);
+
+    device const char * gate_rows[NR0];
+    device const char * up_rows[NR0];
+    FOR_UNROLL (int row = 0; row < NR0; ++row) {
+        const uint64_t offset0 =
+            (r0 + row)*args.nb01 +
+            (i12/FC_mul_mv_r2)*args.nb02 +
+            (i13/FC_mul_mv_r3)*args.nb03;
+        gate_rows[row] = gate_weight + offset0;
+        up_rows[row]   = up_weight   + offset0;
+    }
+
+    float gate_sum[NR0] = {0.f};
+    float up_sum[NR0] = {0.f};
+    const short ix = tiisg/(NW/NQ);
+    const short il = (tiisg%(NW/NQ))*8;
+    device const float * yb = y + ix*QK4_0 + il;
+
+    for (int ib = ix; ib < nb; ib += NQ) {
+        float sumy[2] = {0.f, 0.f};
+        float yl[16];
+        FOR_UNROLL (short i = 0; i < 8; i += 2) {
+            sumy[0] += yb[i] + yb[i + 1];
+            yl[i] = yb[i];
+            yl[i + 1] = yb[i + 1]/256.f;
+            sumy[1] += yb[i + 16] + yb[i + 17];
+            yl[i + 8] = yb[i + 16]/16.f;
+            yl[i + 9] = yb[i + 17]/4096.f;
+        }
+        const float sum = sumy[0] + sumy[1];
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            gate_sum[row] += block_q_n_dot_y(
+                (device const block_q4_0 *) gate_rows[row] + ib,
+                sum, yl, il);
+            up_sum[row] += block_q_n_dot_y(
+                (device const block_q4_0 *) up_rows[row] + ib,
+                sum, yl, il);
+        }
+        yb += QK4_0*NQ;
+    }
+
+    device float * out = (device float *) dst +
+        (uint64_t) im*args.ne0*args.ne1 + (uint64_t) r1*args.ne0;
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const float gate = simd_sum(gate_sum[row]);
+        const float up = simd_sum(up_sum[row]);
+        if (tiisg == 0 && r0 + row < args.ne01) {
+            const float gelu =
+                0.5f*gate*(1.0f + precise::tanh(
+                    SQRT_2_OVER_PI*gate*(1.0f + GELU_COEF_A*gate*gate)));
+            out[r0 + row] = gelu*up;
+        }
+    }
+}
