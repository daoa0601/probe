+static bool ggml_metal_op_can_fuse_q4_0_geglu(ggml_metal_op_t ctx, int idx) {
+    if (getenv("GGML_METAL_Q4_GEGLU_DISABLE") != nullptr ||
+        idx + 3 > ctx->n_nodes()) {
+        return false;
+    }
+
+    const ggml_tensor * gate = ctx->node(idx + 0);
+    const ggml_tensor * up   = ctx->node(idx + 1);
+    const ggml_tensor * glu  = ctx->node(idx + 2);
+    const ggml_metal_device_props * props = ggml_metal_device_get_props(ctx->dev);
+
+    if (props->device_id != GGML_METAL_DEVICE_M4_PRO ||
+        gate->op != GGML_OP_MUL_MAT ||
+        up->op != GGML_OP_MUL_MAT ||
+        glu->op != GGML_OP_GLU ||
+        ggml_get_glu_op(glu) != GGML_GLU_OP_GEGLU ||
+        gate->src[0]->type != GGML_TYPE_Q4_0 ||
+        up->src[0]->type != GGML_TYPE_Q4_0 ||
+        gate->src[1]->type != GGML_TYPE_F32 ||
+        gate->type != GGML_TYPE_F32 ||
+        up->type != GGML_TYPE_F32 ||
+        glu->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (gate->src[1] != up->src[1] ||
+        glu->src[0] != gate ||
+        glu->src[1] != up ||
+        ctx->use_count(gate) != 1 ||
+        ctx->use_count(up) != 1 ||
+        !ggml_are_same_shape(gate, up) ||
+        !ggml_are_same_shape(gate, glu) ||
+        !ggml_are_same_shape(gate->src[0], up->src[0]) ||
+        gate->src[1]->ne[1] != 1 ||
+        gate->ne[2] != 1 ||
+        gate->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_is_contiguous(gate->src[0]) ||
+        !ggml_is_contiguous(up->src[0]) ||
+        !ggml_is_contiguous(gate->src[1]) ||
+        !ggml_is_contiguous(glu)) {
+        return false;
+    }
+    for (int i = 0; i < 3; ++i) {
+        const ggml_tensor * node = ctx->node(idx + i);
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            (i < 2 && (node->flags & GGML_TENSOR_FLAG_OUTPUT) != 0)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int ggml_metal_q4_down_norm_layer(
+        const ggml_tensor * down_weight) {
+    int layer = -1;
+    int consumed = 0;
+    if (sscanf(
+            down_weight->name,
+            "blk.%d.ffn_down.weight%n",
+            &layer,
+            &consumed) != 1 ||
+        down_weight->name[consumed] != '\0' ||
+        layer < 0 ||
+        layer >= GGML_METAL_Q4_DOWN_NORM_SCRATCH_LAYERS) {
+        return -1;
+    }
+    return layer;
+}
+
+static bool ggml_metal_op_can_fuse_q4_0_down_norm_add(
+        ggml_metal_op_t ctx,
+        int idx) {
+    if (getenv("GGML_METAL_Q4_DOWN_NORM_DISABLE") != nullptr ||
+        idx + 5 > ctx->n_nodes()) {
+        return false;
+    }
+
+    const ggml_tensor * mm        = ctx->node(idx + 0);
+    const ggml_tensor * norm      = ctx->node(idx + 1);
+    const ggml_tensor * norm_mul  = ctx->node(idx + 2);
+    const ggml_tensor * add       = ctx->node(idx + 3);
+    const ggml_tensor * out_scale = ctx->node(idx + 4);
+    const ggml_metal_device_props * props =
+        ggml_metal_device_get_props(ctx->dev);
+
+    if (props->device_id != GGML_METAL_DEVICE_M4_PRO ||
+        mm->op        != GGML_OP_MUL_MAT ||
+        norm->op      != GGML_OP_RMS_NORM ||
+        norm_mul->op  != GGML_OP_MUL ||
+        add->op       != GGML_OP_ADD ||
+        out_scale->op != GGML_OP_MUL ||
+        mm->src[0]->type != GGML_TYPE_Q4_0 ||
+        mm->src[1]->type != GGML_TYPE_F32 ||
+        mm->type          != GGML_TYPE_F32 ||
+        norm->type        != GGML_TYPE_F32 ||
+        norm_mul->src[1]->type != GGML_TYPE_F32 ||
+        add->src[1]->type      != GGML_TYPE_F32 ||
+        out_scale->src[1]->type != GGML_TYPE_F32 ||
+        out_scale->type         != GGML_TYPE_F32) {
+        return false;
+    }
+
+    // Restrict this fusion to the two measured Gemma 4 decode tails:
+    // the 12B target's [15360, 3840] projection and the MTP assistant's
+    // [8192, 1024] projection. Both consume one F32 token and end in a
+    // scalar layer-output scale.
+    const bool target_shape =
+        mm->src[0]->ne[0] == 15360 &&
+        mm->src[0]->ne[1] == 3840 &&
+        mm->src[1]->ne[0] == 15360 &&
+        mm->ne[0] == 3840;
+    const bool assistant_shape =
+        mm->src[0]->ne[0] == 8192 &&
+        mm->src[0]->ne[1] == 1024 &&
+        mm->src[1]->ne[0] == 8192 &&
+        mm->ne[0] == 1024;
+    if (assistant_shape &&
+        getenv("GGML_METAL_Q4_MTP_DOWN_NORM_DISABLE") != nullptr) {
+        return false;
+    }
+    if ((!target_shape && !assistant_shape) ||
+        mm->src[1]->ne[1] != 1 ||
+        mm->ne[1] != 1 ||
+        mm->ne[2] != 1 ||
+        mm->ne[3] != 1) {
+        return false;
+    }
+    if (ctx->q4_down_norm_scratch.metal == nullptr ||
+        ggml_metal_q4_down_norm_layer(mm->src[0]) < 0) {
+        return false;
+    }
+
+    if (norm->src[0] != mm ||
+        norm_mul->src[0] != norm ||
+        add->src[0] != norm_mul ||
+        out_scale->src[0] != add ||
+        ggml_nelements(out_scale->src[1]) != 1 ||
+        !ggml_are_same_shape(mm, norm) ||
+        !ggml_are_same_shape(norm, norm_mul) ||
+        !ggml_are_same_shape(norm_mul, add) ||
+        !ggml_are_same_shape(add, out_scale)) {
+        if (ctx->debug_fusion > 1) {
+            GGML_LOG_DEBUG(
+                "%s: reject Gemma down tail: dependency/shape mismatch\n",
+                __func__);
+        }
+        return false;
+    }
+
+    if (ctx->use_count(mm) != 1 ||
+        ctx->use_count(norm) != 1 ||
+        ctx->use_count(norm_mul) != 1 ||
+        ctx->use_count(add) != 1 ||
+        !ggml_is_contiguous(mm->src[0]) ||
+        !ggml_is_contiguous(mm->src[1]) ||
+        !ggml_is_contiguous(mm) ||
+        !ggml_is_contiguous(norm) ||
+        !ggml_is_contiguous(norm_mul->src[1]) ||
+        !ggml_is_contiguous(add->src[1]) ||
+        !ggml_is_contiguous(out_scale->src[1]) ||
+        !ggml_is_contiguous(out_scale)) {
+        if (ctx->debug_fusion > 1) {
+            GGML_LOG_DEBUG(
+                "%s: reject Gemma down tail: uses=[%d,%d,%d,%d], contiguous=[%d,%d,%d,%d,%d,%d,%d,%d]\n",
+                __func__,
+                ctx->use_count(mm),
+                ctx->use_count(norm),
+                ctx->use_count(norm_mul),
+                ctx->use_count(add),
+                ggml_is_contiguous(mm->src[0]),
+                ggml_is_contiguous(mm->src[1]),
+                ggml_is_contiguous(mm),
+                ggml_is_contiguous(norm),
+                ggml_is_contiguous(norm_mul->src[1]),
+                ggml_is_contiguous(add->src[1]),
+                ggml_is_contiguous(out_scale->src[1]),
+                ggml_is_contiguous(out_scale));
+        }
+        return false;
+    }
+
+    for (int i = 0; i < 5; ++i) {
+        const ggml_tensor * node = ctx->node(idx + i);
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            (i < 4 && (node->flags & GGML_TENSOR_FLAG_OUTPUT) != 0)) {
+            if (ctx->debug_fusion > 1) {
+                GGML_LOG_DEBUG(
+                    "%s: reject Gemma down tail: node %d flags=0x%x\n",
+                    __func__, i, node->flags);
+            }
+            return false;
+        }
+    }
+
+    const ggml_metal_buffer_id raw      = ggml_metal_get_buffer_id(mm);
+    const ggml_metal_buffer_id residual =
+        ggml_metal_get_buffer_id(add->src[1]);
+    const size_t nbytes = ggml_nbytes(mm);
+    const auto overlaps = [nbytes](
+            ggml_metal_buffer_id a,
+            ggml_metal_buffer_id b) {
+        return a.metal == b.metal &&
+            a.offs < b.offs + nbytes &&
+            b.offs < a.offs + nbytes;
+    };
+    if (overlaps(raw, residual)) {
+        if (ctx->debug_fusion > 1) {
+            GGML_LOG_DEBUG(
+                "%s: reject Gemma down tail: raw/residual overlap raw=%p+%zu residual=%p+%zu bytes=%zu\n",
+                __func__,
+                raw.metal, raw.offs,
+                residual.metal, residual.offs,
+                nbytes);
+        }
+        return false;
+    }
+
+    return true;
+}
+
+static uint32_t ggml_metal_q4_down_norm_epoch() {
+    static std::atomic<uint32_t> next_epoch { 0 };
+    uint32_t epoch =
+        next_epoch.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (epoch == 0) {
+        epoch =
+            next_epoch.fetch_add(1, std::memory_order_relaxed) + 1;
+    }
+    return epoch;
+}
