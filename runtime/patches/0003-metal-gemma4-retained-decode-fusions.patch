+// Gemma 4 12B decode tail:
+// Q4_0 down projection -> RMS norm -> norm weight -> residual add ->
+// scalar layer output scale. The last-arriving workgroup closes the global
+// reduction, avoiding both post-matvec dispatches.
+template<short NR0, short NSG, short NACC>
+void kernel_mul_mv_q4_0_f32_down_norm_add_impl(
+        constant ggml_metal_kargs_q4_0_down_norm_add & args,
+        device const char * weight,
+        device const char * activation,
+        device       float * raw,
+        device atomic_uint * state,
+        device const float * norm_weight,
+        device const float * residual,
+        device const float * out_scale,
+        device       float * dst,
+        threadgroup float * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 16;
+
+    const int nb = args.mv.ne00/QK4_0;
+    const int r0 = (tgpig.x*NSG + sgitg)*NR0;
+    device const float * y = (device const float *) activation;
+
+    device const block_q4_0 * rows[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        rows[row] = (device const block_q4_0 *)
+            (weight + (r0 + row)*args.mv.nb01);
+    }
+
+    float sums[NR0][NACC] = {{0.0f}};
+    const short ix = tiisg/(NW/NQ);
+    const short il = (tiisg%(NW/NQ))*8;
+
+    for (int ib0 = ix; ib0 < nb; ib0 += NQ*NACC) {
+        FOR_UNROLL (short accum = 0; accum < NACC; ++accum) {
+            const int ib = ib0 + accum*NQ;
+            if (ib >= nb) {
+                continue;
+            }
+            device const float * yb = y + ib*QK4_0 + il;
+            float sumy[2] = {0.0f, 0.0f};
+            float yl[16];
+            FOR_UNROLL (short i = 0; i < 8; i += 2) {
+                sumy[0] += yb[i] + yb[i + 1];
+                yl[i] = yb[i];
+                yl[i + 1] = yb[i + 1]/256.0f;
+                sumy[1] += yb[i + 16] + yb[i + 17];
+                yl[i + 8] = yb[i + 16]/16.0f;
+                yl[i + 9] = yb[i + 17]/4096.0f;
+            }
+            const float sum = sumy[0] + sumy[1];
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                sums[row][accum] += block_q_n_dot_y(
+                    rows[row] + ib, sum, yl, il);
+            }
+        }
+    }
+
+    float local_sq = 0.0f;
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        float lane_sum = 0.0f;
+        FOR_UNROLL (short accum = 0; accum < NACC; ++accum) {
+            lane_sum += sums[row][accum];
+        }
+        const float value = simd_sum(lane_sum);
+        if (tiisg == 0 && r0 + row < args.mv.ne01) {
+            raw[r0 + row] = value;
+            local_sq += value*value;
+        }
+    }
+
+    if (tgpig.x == 0 && sgitg == 0 && tiisg == 0) {
+        atomic_store_explicit(
+            state + 1, 0u, memory_order_relaxed);
+        atomic_store_explicit(
+            state, args.epoch, memory_order_relaxed);
+    }
+
+    if (tiisg == 0) {
+        while (atomic_load_explicit(
+                state, memory_order_relaxed) != args.epoch) {
+        }
+        shmem[sgitg] = local_sq;
+    }
+    threadgroup_barrier(
+        mem_flags::mem_threadgroup | mem_flags::mem_device);
+
+    if (sgitg == 0) {
+        const float group_sq =
+            simd_sum(tiisg < NSG ? shmem[tiisg] : 0.0f);
+        if (tiisg == 0) {
+            atomic_store_explicit(
+                state + 2 + tgpig.x,
+                as_type<uint>(group_sq),
+                memory_order_relaxed);
+        }
+    }
+    // Metal only exposes relaxed device atomics. Mirror WGSL's
+    // atomicStore -> storageBarrier -> atomicAdd completion protocol by
+    // forcing the partial publication to device memory before taking the
+    // arrival ticket.
+    threadgroup_barrier(
+        mem_flags::mem_threadgroup | mem_flags::mem_device);
+
+    if (sgitg == 0 && tiisg == 0) {
+            const uint ticket = atomic_fetch_add_explicit(
+                state + 1, 1u, memory_order_relaxed);
+            shmem[0] = ticket == (uint) args.n_groups - 1u
+                ? 1.0f
+                : 0.0f;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (shmem[0] == 0.0f) {
+        return;
+    }
+
+    const uint thread_index = sgitg*NW + tiisg;
+    float total_sq = 0.0f;
+    for (uint group = thread_index;
+         group < (uint) args.n_groups;
+         group += NSG*NW) {
+        total_sq += as_type<float>(atomic_load_explicit(
+            state + 2 + group, memory_order_relaxed));
+    }
+    total_sq = simd_sum(total_sq);
+    if (tiisg == 0) {
+        shmem[sgitg] = total_sq;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    total_sq = simd_sum(tiisg < NSG ? shmem[tiisg] : 0.0f);
+    const float rms_scale =
+        1.0f/sqrt(total_sq/(float) args.mv.ne01 + args.eps);
+    const float layer_scale = out_scale[0];
+    for (uint row = thread_index;
+         row < (uint) args.mv.ne01;
+         row += NSG*NW) {
+        dst[row] =
+            (raw[row]*rms_scale*norm_weight[row] + residual[row])*
+            layer_scale;
+    }
+    threadgroup_barrier(mem_flags::mem_device);
+    if (sgitg == 0 && tiisg == 0) {
+        atomic_store_explicit(
+            state + 1, 0u, memory_order_relaxed);
+    }
