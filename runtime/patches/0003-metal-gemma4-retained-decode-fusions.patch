+            scale0 +
+            (batch%norm_args.nef3[1])*norm_args.nbf3[1] +
+            (token%norm_args.nef2[1])*norm_args.nbf2[1] +
+            (head%norm_args.nef1[1])*norm_args.nbf1[1]);
+
+    float sum = 0.0f;
+    for (int i00 = tpitg.x; i00 < norm_args.ne00_t; i00 += ntg.x) {
+        sum += dot(x4[i00], x4[i00]);
+    }
+    sum = simd_sum(sum);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sum;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sum = simd_sum(shmem_f32[tiisg]);
+    const float rms_scale =
+        1.0f/sqrt(sum/norm_args.ne00 + norm_args.eps);
+
+    device const int64_t * index_ptr =
+        (device const int64_t *) (
+            row_indices +
+            token*set_args.nb10 +
+            (batch%set_args.ne12)*set_args.nb12);
+    const int64_t row = index_ptr[0];
+    device half * output =
+        (device half *) (
+            cache +
+            row*set_args.nb1 +
+            batch*set_args.nb3) +
+        head*rope_args.ne0;
+
+    device const float * x = (device const float *) x4;
+    device const float * weight = (device const float *) scale4;
+
+    float corr_dims[2];
+    rope_yarn_corr_dims(
+        rope_args.n_dims,
+        rope_args.n_ctx_orig,
+        rope_args.freq_base,
+        rope_args.beta_fast,
+        rope_args.beta_slow,
+        corr_dims);
+
+    device const int32_t * pos =
+        (device const int32_t *) positions;
+    const float theta_base = (float) pos[token];
+    const float inv_ndims = -1.0f/rope_args.n_dims;
+    const int half_dims = rope_args.n_dims/2;
+
+    for (int ic = tpitg.x; ic < half_dims; ic += ntg.x) {
+        const int i0 = 2*ic;
+        const float theta =
+            theta_base*pow(rope_args.freq_base, inv_ndims*i0);
+        const float freq_factor =
+            rope_args.src2
+                ? ((device const float *) freq_factors)[ic]
+                : 1.0f;
+
+        float cos_theta;
+        float sin_theta;
+        rope_yarn(
+            theta/freq_factor,
+            rope_args.freq_scale,
+            corr_dims,
+            i0,
+            rope_args.ext_factor,
+            rope_args.attn_factor,
+            &cos_theta,
+            &sin_theta);
+
+        const float x0 = (x[ic]*rms_scale)*weight[ic];
+        const float x1 =
+            (x[half_dims + ic]*rms_scale)*weight[half_dims + ic];
+
+        output[ic] =
+            (half) (x0*cos_theta - x1*sin_theta);
+        output[half_dims + ic] =
+            (half) (x0*sin_theta + x1*cos_theta);
+    }
+
+    for (int i0 = rope_args.n_dims + tpitg.x;
+         i0 < rope_args.ne0;
+         i0 += ntg.x) {
+        output[i0] =
+            (half) ((x[i0]*rms_scale)*weight[i0]);
+    }
+}
