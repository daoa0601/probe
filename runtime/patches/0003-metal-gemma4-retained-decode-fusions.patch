+// Gemma 4 attention-head post-processing:
+// RMS norm -> per-channel scale -> NeoX RoPE.
+//
+// The stock graph launches one reduction kernel and one RoPE kernel. For the
+// 256-element Gemma head, 64 threads can reproduce the float4 RMS reduction
+// order and then rotate two pairs per thread in the same threadgroup.
+kernel void kernel_rms_norm_mul_rope_neox_f32(
+        constant ggml_metal_kargs_norm & norm_args,
+        constant ggml_metal_kargs_rope & rope_args,
+        device const char * src0,
+        device const char * scale0,
+        device const char * positions,
+        device const char * freq_factors,
+        device       char * dst,
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const float4 * x4 =
+        (device const float4 *) (
+            src0 +
+            i03*norm_args.nbf3[0] +
+            i02*norm_args.nbf2[0] +
+            i01*norm_args.nbf1[0]);
+    device const float4 * scale4 =
+        (device const float4 *) (
+            scale0 +
+            (i03%norm_args.nef3[1])*norm_args.nbf3[1] +
+            (i02%norm_args.nef2[1])*norm_args.nbf2[1] +
+            (i01%norm_args.nef1[1])*norm_args.nbf1[1]);
+
+    float sum = 0.0f;
+    for (int i00 = tpitg.x; i00 < norm_args.ne00_t; i00 += ntg.x) {
+        sum += dot(x4[i00], x4[i00]);
+    }
+    sum = simd_sum(sum);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sum;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sum = simd_sum(shmem_f32[tiisg]);
+    const float rms_scale =
+        1.0f/sqrt(sum/norm_args.ne00 + norm_args.eps);
+
+    device const float * x = (device const float *) x4;
+    device const float * weight = (device const float *) scale4;
+    device float * output =
+        (device float *) (
+            dst +
+            i03*rope_args.nb3 +
+            i02*rope_args.nb2 +
+            i01*rope_args.nb1);
+
+    float corr_dims[2];
+    rope_yarn_corr_dims(
+        rope_args.n_dims,
+        rope_args.n_ctx_orig,
+        rope_args.freq_base,
+        rope_args.beta_fast,
+        rope_args.beta_slow,
+        corr_dims);
+
+    device const int32_t * pos =
+        (device const int32_t *) positions;
+    const float theta_base = (float) pos[i02];
+    const float inv_ndims = -1.0f/rope_args.n_dims;
+    const int half_dims = rope_args.n_dims/2;
+
+    for (int ic = tpitg.x; ic < half_dims; ic += ntg.x) {
+        const int i0 = 2*ic;
+        const float theta =
+            theta_base*pow(rope_args.freq_base, inv_ndims*i0);
+        const float freq_factor =
+            rope_args.src2
+                ? ((device const float *) freq_factors)[ic]
+                : 1.0f;
+
+        float cos_theta;
+        float sin_theta;
+        rope_yarn(
+            theta/freq_factor,
+            rope_args.freq_scale,
+            corr_dims,
+            i0,
+            rope_args.ext_factor,
+            rope_args.attn_factor,
+            &cos_theta,
+            &sin_theta);
+
+        const float x0 = (x[ic]*rms_scale)*weight[ic];
+        const float x1 =
+            (x[half_dims + ic]*rms_scale)*weight[half_dims + ic];
+
+        output[ic] =
+            x0*cos_theta - x1*sin_theta;
+        output[half_dims + ic] =
+            x0*sin_theta + x1*cos_theta;
+    }
+
+    for (int i0 = rope_args.n_dims + tpitg.x;
+         i0 < rope_args.ne0;
+         i0 += ntg.x) {
+        output[i0] = (x[i0]*rms_scale)*weight[i0];
+    }
+}
